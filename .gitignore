# Gradle
.gradle/
build/
out/

# IDE build output (Eclipse/VS Code Java). Mirrors build/, which is already ignored.
bin/

# The Gradle wrapper jar MUST stay tracked, or ./gradlew will not work on a fresh clone.
!gradle/wrapper/gradle-wrapper.jar

# Minecraft dev runtime (natives, world saves, server.properties, logs)
run/

# HBM Nuclear Tech Mod is a dev-only compile dependency and is NOT redistributed here.
# Drop your own copy of HBM-NTM-*.jar into libs/ before building -- see README.md.
# The trailing * also catches temporarily renamed jars (e.g. *.jar.disabled used to
# toggle an optional dev dependency without deleting the file).
libs/*.jar*

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project

# Local tooling / machine-specific settings
.claude/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Runtime logs generated by Forge-backed unit tests
logs/
